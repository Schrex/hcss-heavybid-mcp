{
  "name": "schrex-hcss-heavybid",
  "version": "0.6.0",
  "private": true,
  "description": "Remote (Streamable HTTP) read-only MCP connector for HCSS HeavyBid on Cloudflare Workers (free plan), Schreiber Excavating",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.factor.json && node --test test/factor.test.mjs",
    "reconcile": "tsc -p tsconfig.factor.json && node scripts/reconcile.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "fflate": "^0.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.5.0",
    "wrangler": "^4.153.0"
  },
  "engines": {
    "node": ">=22"
  }
}
